{
  "name": "fl-advocacia-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Fonseca Lisboa Advocacia",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs --no-watch",
    "testar:local": "node scripts/testar-local.mjs",
    "check": "node scripts/check.mjs",
    "og": "node scripts/og.mjs",
    "marca": "node scripts/marca.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "sistema:test": "node --test \"sistema/testes/*.test.mjs\"",
    "banco:test": "node scripts/validar-banco.mjs",
    "testar:banco": "node scripts/testar-local.mjs --banco"
  }
}
